# ==============================================================================
# HealthAthon BPJS Monorepo - Master Environment Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API CONFIGURATION (apps/api/.env & Railway Variables)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# URL Frontend (Local: http://localhost:5173 | Prod: URL Vercel)
CLIENT_URL=http://localhost:5173

# Supabase Credentials (Database & Auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenRouter AI Credentials (Backend server-side only)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_DEFAULT_MODEL=openai/gpt-oss-120b:nitro

# OpenAI Credentials (Backend server-side only: v2 Direct Chat gpt-4o-mini & WebRTC Realtime Luna)
OPENAI_API_KEY=sk-proj-your-openai-key

# ElevenLabs Voice TTS/STT Key (Backend server-side only)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Redis Multi-Tier Cache & Distributed Rate Limiter (Optional — L1 Memory LRU fallback active by default)
# Opsi A (Railway / Standard Redis TCP/TLS):
REDIS_URL=
# Opsi B (Vercel KV / Upstash Serverless HTTP REST):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=infera:

# ------------------------------------------------------------------------------
# 2. FRONTEND WEB CONFIGURATION (apps/web/.env & Vercel Variables)
# Awalan VITE_ diekspos ke browser — JANGAN letakkan secret key di variabel VITE_!
# ------------------------------------------------------------------------------
# URL Backend API (Local: http://localhost:4000/api/v1 | Prod: https://[railway-url]/api/v1)
VITE_API_URL=http://localhost:4000/api/v1

# Supabase Client Credentials (Public Anon Key dengan proteksi RLS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Default AI Model & Voice Preset ID (Non-secret)
VITE_DEFAULT_MODEL=openai/gpt-oss-120b:nitro
VITE_ELEVENLABS_VOICE_ID=3bAVnCtF2Efx7MOj2bJ0
