# ==============================================================================
# HealthAthon BPJS Monorepo - Master Environment Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API CONFIGURATION (apps/api/.env & Railway Variables)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# URL Frontend (Local: http://localhost:5173 | Prod: URL Vercel)
CLIENT_URL=http://localhost:5173

# Supabase Credentials (Database & Auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenRouter AI Credentials (Backend fallback)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_DEFAULT_MODEL=openai/gpt-oss-120b:nitro

# ------------------------------------------------------------------------------
# 2. FRONTEND WEB CONFIGURATION (apps/web/.env & Vercel Variables)
# Awalan VITE_ wajib agar bisa diakses oleh browser/React Vite
# ------------------------------------------------------------------------------
# URL Backend API (Local: http://localhost:4000/api/v1 | Prod: https://[railway-url]/api/v1)
VITE_API_URL=http://localhost:4000/api/v1

# Supabase Client Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI LLM (OpenRouter)
VITE_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
VITE_DEFAULT_MODEL=openai/gpt-oss-120b:nitro

# Voice TTS (ElevenLabs)
# Default Voice: Vera (GgFtkxszsIQcD4MYvQax) | Voice Kedua: Luna (0csCu4D7iyBsmlVlf9Iu)
VITE_ELEVENLABS_API_KEY=your-elevenlabs-api-key
VITE_ELEVENLABS_VOICE_ID=GgFtkxszsIQcD4MYvQax
