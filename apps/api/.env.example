# ========================================================
# Backend Environment Template (apps/api/.env.example)
# Digunakan untuk Express TypeScript API (Local & Railway)
# ========================================================

PORT=4000
NODE_ENV=development

# URL Frontend (Local: http://localhost:5173, Prod di Railway: https://[your-vercel-domain].vercel.app)
CLIENT_URL=http://localhost:5173

# Supabase Credentials (DB & Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenRouter AI Credentials
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_DEFAULT_MODEL=openai/gpt-oss-120b:nitro

# ElevenLabs Voice Credentials (Server-side proxy)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Redis Multi-Tier Cache & Distributed Rate Limit (Railway / Vercel Upstash)
# Untuk Railway Redis: isi REDIS_URL (contoh: redis://default:pass@redis.railway.internal:6379)
REDIS_URL=
# Untuk Vercel KV / Upstash Serverless HTTP: isi UPSTASH_REDIS_REST_URL & UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=infera:
